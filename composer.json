{
    "name": "tanat/php-mini-database",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "PhpMiniDatabase\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpMiniDatabase\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.5",
        "ext-ffi": "*",
        "ext-pcntl": "*",
        "ext-posix": "*",
        "ext-sockets": "*",
        "ext-sysvmsg": "*",
        "ext-sysvsem": "*",
        "ext-sysvshm": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer check --diff"
    },
    "config": {
        "sort-packages": true
    }
}