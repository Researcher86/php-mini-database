includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon

parameters:
    level: 6
    # bin/ scripts are deliberately extensionless (run via their shebang
    # line, never `require`d) - PHPStan's directory scan only picks up
    # files matching `fileExtensions` (default: php), so a bare `bin`
    # directory entry silently analyses nothing inside it. Naming each
    # script explicitly bypasses that filter, since it applies only when
    # `paths` names a directory to search, not a file given directly.
    paths:
        - src
        - tests
        - bin/minidb-server
        - bin/minidb-user
